<!doctype html>
<html lang="da">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Tipsklub – Overblik</title>
  <style>
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial; margin: 24px; line-height: 1.35; }
    h1 { margin: 0 0 8px; }
    .grid { display: grid; gap: 16px; grid-template-columns: 1fr; max-width: 980px; }
    .card { border: 1px solid #ddd; border-radius: 12px; padding: 16px; }
    label { display:block; font-size: 12px; opacity: .8; margin-top: 10px; }
    input { width: 100%; padding: 10px; border-radius: 10px; border: 1px solid #ccc; }
    button { padding: 10px 12px; border-radius: 10px; border: 0; background: #111; color: #fff; cursor: pointer; }
    button.secondary { background: #eee; color: #111; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border-bottom: 1px solid #eee; padding: 10px 6px; text-align: left; }
    .row { display:flex; gap: 10px; flex-wrap: wrap; align-items: end; }
    .row > div { flex: 1 1 180px; }
    .kpi { font-size: 28px; font-weight: 700; }
    .muted { opacity: .75; }
    .pill { display:inline-block; padding: 3px 8px; border-radius: 999px; background:#f2f2f2; font-size:12px; }
  </style>
</head>
<body>
  <h1>Tipsklub</h1>
  <div class="muted">Bet 1: 3/5 med bøder · Bet 2: 4/5 max odds 1,50 uden bøder</div>

  <div class="grid">
    <div class="card">
      <div class="row">
        <div>
          <div class="muted">Saldo</div>
          <div id="saldo" class="kpi">0,00</div>
          <div class="muted">Seneste uge: <span id="latestWeek">—</span></div>
        </div>
        <div>
          <button onclick="exportJson()">Eksportér data</button>
          <button class="secondary" onclick="resetAll()">Nulstil</button>
        </div>
      </div>
    </div>

    <div class="card">
      <h2 style="margin-top:0">Tilføj uge</h2>
      <div class="row">
        <div>
          <label>Uge (fx 1 / 2026-01-04)</label>
          <input id="week" placeholder="Uge 1" />
        </div>
        <div>
          <label>Overført</label>
          <input id="overfort" type="number" step="0.01" placeholder="1133.50" />
        </div>
        <div>
          <label>Spillet Bet 1 (typisk -50)</label>
          <input id="spil1" type="number" step="0.01" value="-50" />
        </div>
        <div>
          <label>Spillet Bet 2 (typisk -50 / 0 hvis ikke spillet)</label>
          <input id="spil2" type="number" step="0.01" value="-50" />
        </div>
        <div>
          <label>Vundet Bet 1</label>
          <input id="win1" type="number" step="0.01" value="0" />
        </div>
        <div>
          <label>Vundet Bet 2</label>
          <input id="win2" type="number" step="0.01" value="0" />
        </div>
        <div>
          <label>Ugens bøder (fra Bet 1)</label>
          <input id="boder" type="number" step="1" value="0" />
        </div>
        <div>
          <label>Tipsters</label>
          <input id="tipsters" placeholder="Mads / Franke" />
        </div>
      </div>
      <div style="margin-top:12px">
        <button onclick="addWeek()">Gem uge</button>
      </div>
      <div class="muted" style="margin-top:10px">
        Bøder: odds &lt;1,50 = 10 kr · 1,50–1,99 = 20 kr · ≥2,00 = 30 kr
      </div>
    </div>

    <div class="card">
      <h2 style="margin-top:0">Historik</h2>
      <table>
        <thead>
          <tr>
            <th>Uge</th>
            <th>Tipsters</th>
            <th>Resultat</th>
            <th>Bøder</th>
            <th>Saldo slut</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
      <div class="muted" style="margin-top:8px">Tip: Klik “Slet” hvis en uge er tastet forkert.</div>
    </div>
  </div>

<script>
  const KEY = "tipsklub_data_v1";

  function load() {
    return JSON.parse(localStorage.getItem(KEY) || "[]");
  }
  function save(data) {
    localStorage.setItem(KEY, JSON.stringify(data));
  }
  function fmt(n) {
    const x = Number(n || 0);
    return x.toLocaleString("da-DK", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function computeSaldoSlut(item) {
    const spilIalt = Number(item.spil1) + Number(item.spil2);
    const winIalt  = Number(item.win1) + Number(item.win2);
    const resultat = winIalt + spilIalt;
    return Number(item.overfort) + resultat + Number(item.boder);
  }

  function render() {
    const data = load();
    const tbody = document.getElementById("rows");
    tbody.innerHTML = "";

    let latest = data[data.length - 1];
    document.getElementById("latestWeek").textContent = latest ? latest.week : "—";
    document.getElementById("saldo").textContent = fmt(latest ? latest.saldoSlut : 0);

    data.forEach((item, idx) => {
      const spilIalt = Number(item.spil1) + Number(item.spil2);
      const winIalt  = Number(item.win1) + Number(item.win2);
      const resultat = winIalt + spilIalt;

      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td>${item.week} <span class="pill">${item.spil2 == 0 ? "Bet 2 ikke spillet" : "Bet 2 spillet"}</span></td>
        <td>${item.tipsters || "—"}</td>
        <td>${fmt(resultat)}</td>
        <td>${fmt(item.boder)}</td>
        <td><strong>${fmt(item.saldoSlut)}</strong></td>
        <td><button class="secondary" onclick="del(${idx})">Slet</button></td>
      `;
      tbody.appendChild(tr);
    });
  }

  function addWeek() {
    const data = load();
    const week = document.getElementById("week").value.trim() || `Uge ${data.length + 1}`;

    const item = {
      week,
      overfort: Number(document.getElementById("overfort").value || (data[data.length-1]?.saldoSlut ?? 0)),
      spil1: Number(document.getElementById("spil1").value || -50),
      spil2: Number(document.getElementById("spil2").value || -50),
      win1: Number(document.getElementById("win1").value || 0),
      win2: Number(document.getElementById("win2").value || 0),
      boder: Number(document.getElementById("boder").value || 0),
      tipsters: document.getElementById("tipsters").value.trim()
    };

    item.saldoSlut = computeSaldoSlut(item);
    data.push(item);
    save(data);

    // Autofill next overført
    document.getElementById("overfort").value = item.saldoSlut;
    document.getElementById("week").value = "";
    document.getElementById("win1").value = 0;
    document.getElementById("win2").value = 0;
    document.getElementById("boder").value = 0;

    render();
  }

  function del(idx) {
    const data = load();
    data.splice(idx, 1);
    save(data);
    render();
  }

  function exportJson() {
    const data = load();
    const blob = new Blob([JSON.stringify(data, null, 2)], {type: "application/json"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "tipsklub-data.json";
    a.click();
    URL.revokeObjectURL(url);
  }

  function resetAll() {
    if (!confirm("Vil du nulstille alle data?")) return;
    localStorage.removeItem(KEY);
    render();
  }

  render();
</script>
</body>
</html>
